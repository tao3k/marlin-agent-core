load("//bazel:marlin_crates.bzl", "all_crate_deps", "crate_edition")
load("//bazel:marlin_rust.bzl", "marlin_rust_binary", "marlin_rust_crate", "marlin_rust_scenario")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "policy_sources",
    srcs = glob(["tests/support/**/*.rs"]),
    visibility = ["//crates/marlin-agent-storage:__pkg__"],
)

marlin_rust_crate(
    name = "marlin_rust_project_harness_policy",
    srcs = glob(["src/**/*.rs"]),
    build_action = "none",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    manifest = "Cargo.toml",
    visibility = ["//visibility:public"],
)

marlin_rust_binary(
    name = "marlin_workspace_package_gate",
    srcs = [
        "examples/marlin-workspace-package-gate.rs",
        ":policy_sources",
    ],
    build_action = "harness",
    crate_root = "examples/marlin-workspace-package-gate.rs",
    edition = crate_edition(),
    manifest = "Cargo.toml",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal_dev = True),
)

marlin_rust_scenario(
    name = "unit_test",
    srcs = glob(["tests/**/*.rs"]),
    build_action = "harness",
    crate_root = "tests/unit_test.rs",
    data = ["//:policy_unit_workspace_runtime_data"],
    edition = crate_edition(),
    manifest = "Cargo.toml",
    scenario = "unit",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal_dev = True),
)

filegroup(
    name = "policy_unit_runtime_data",
    srcs = [
        "Cargo.toml",
        ":policy_sources",
    ] + glob([
        "src/**/*.rs",
        "tests/unit_test.rs",
    ]),
    visibility = ["//:__pkg__"],
)
