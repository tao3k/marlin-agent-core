load("//bazel:marlin_crates.bzl", "all_crate_deps", "crate_edition")
load("//bazel:marlin_rust.bzl", "marlin_rust_crate", "marlin_rust_scenario")

package(default_visibility = ["//visibility:private"])

marlin_rust_crate(
    name = "marlin_rust_project_harness_policy",
    srcs = glob(["src/**/*.rs"]),
    build_action = "none",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    manifest = "Cargo.toml",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(),
)

marlin_rust_scenario(
    name = "workspace_policy",
    srcs = glob(["tests/**/*.rs"]),
    build_action = "harness",
    crate_root = "tests/workspace_policy.rs",
    data = ["//:policy_unit_workspace_runtime_data"],
    edition = crate_edition(),
    manifest = "Cargo.toml",
    scenario = "integration",
    visibility = ["//visibility:public"],
    deps = [":marlin_rust_project_harness_policy"] + all_crate_deps(normal_dev = True),
)

filegroup(
    name = "policy_unit_runtime_data",
    srcs = [
        "Cargo.toml",
    ] + glob([
        "src/**/*.rs",
        "tests/workspace_policy.rs",
    ]),
    visibility = ["//:__pkg__"],
)
