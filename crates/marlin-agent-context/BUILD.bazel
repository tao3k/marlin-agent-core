load("@marlin_crates//:defs.bzl", "crate_deps", "crate_edition")
load("//bazel:marlin_harness.bzl", "marlin_crate_with_policy_data")

marlin_crate_with_policy_data(
    name = "marlin_agent_context",
    srcs = glob(["src/**/*.rs"]),
    compile_data = glob(["src/org/workspace/contracts/*.org"], exclude = ["src/org/workspace/contracts/README.org"]),
    edition = crate_edition(),
    crate_features = ["org-source", "org-workspace", "org-memory", "org-workflow"],
    gate_data = glob(["tests/**/*.rs"]),
    proc_macro_deps = crate_deps(["async-trait"]),
    deps = crate_deps(["parking_lot", "serde", "serde_json", "orgize", "thiserror"]) + [
        "//crates/marlin-agent-graph:marlin_agent_graph",
        "//crates/marlin-agent-protocol:marlin_agent_protocol",
        "//crates/marlin-gerbil-ir:marlin_gerbil_ir",
        "//crates/marlin-agent-context/parts/org-model:marlin_context_org_model",
        "//crates/marlin-workspace-protocol:marlin_workspace_protocol",
        "//crates/marlin-workspace-query:marlin_workspace_query",
        "//crates/marlin-workspace-status:marlin_workspace_status",
        "//crates/marlin-workspace-view:marlin_workspace_view",
    ],
)
