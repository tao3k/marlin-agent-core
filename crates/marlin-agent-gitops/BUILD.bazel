load("@marlin_crates//:defs.bzl", "crate_deps", "crate_edition")
load("//bazel:marlin_harness.bzl", "marlin_crate_with_policy_data")

marlin_crate_with_policy_data(
    name = "marlin_agent_gitops",
    srcs = glob(["src/**/*.rs"]),
    edition = crate_edition(),
    gate_data = glob(["tests/**/*.rs"]),
    deps = ["//crates/marlin-agent-protocol:marlin_agent_protocol"] + crate_deps([
        "serde",
        "thiserror",
        "tokio",
    ]),
)
