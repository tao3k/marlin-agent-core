;;; Identity-owned Gerbil Actors with reusable mailboxes and independent replies.

(import (only-in :clan/poo/object .o)
        (only-in :std/actor/interaction mailbox-next mailbox-empty))

(export open-deck-mailboxes
        deck-reply? deck-reply-id deck-reply-failed? deck-reply-value
        deck-notice? deck-notice-kind deck-notice-module deck-notice-id deck-notice-due deck-notice-observed)

(defstruct deck-group (actors submitted collected))
(defstruct deck-reply (token group id failed? value))
(defstruct deck-notice (token kind module id due observed))

(def (open-deck-mailboxes module-of route handler)
  (def owner (current-thread))
  (def groups (make-hash-table-eqv))
  (def created 0)
  (def token (gensym 'deck-mailbox))
  (def next-id 1)
  (def collected 0)
  (def retired 0)
  (def closed? #f)
  (def recent-module #f)
  (def recent-group #f)
  (def recent-key #f)
  (def recent-actor #f)
  (def (assert-owner)
    (unless (eq? owner (current-thread))
      (error "Deck mailboxes belong to their opening Scheme thread")))
  (def (assert-open)
    (assert-owner)
    (when closed? (error "Deck mailboxes are closed")))
  (def (serve group)
    (def message #f)
    ;; Keep the exception continuation for the receiving Actor's lifetime.
    ;; A handler failure publishes its own reply and reopens the same mailbox
    ;; loop. Successful messages allocate no new exception continuation.
    (let restart ()
      (with-catch
        (lambda (failure)
          (unless message (raise failure))
          (thread-send owner (make-deck-reply token group (car message) #t failure))
          (set! message #f)
          (restart))
        (lambda ()
          (let loop ()
            (set! message (thread-receive))
            (unless (eq? message 'stop)
              (let (value (handler (cdr message)))
                (thread-send owner (make-deck-reply token group (car message) #f value)))
              (set! message #f)
              (loop)))))))
  (def (dispatch message)
    (assert-open)
    (when (and (not (fixnum? next-id)) (> next-id 18446744073709551615))
      (error "Deck message identity exhausted"))
    (def module (module-of message))
    (def group (if (and recent-group (eqv? module recent-module)) recent-group
                 (or (hash-get groups module) (error "Deck Module is not active"))))
    (def actors (deck-group-actors group))
    (def key (route message))
    (def actor
      (if (and (eq? group recent-group) recent-actor (equal? key recent-key)) recent-actor
        (let (actor
               (or (hash-get actors key)
                   (let (actor (spawn (lambda () (serve group))))
                     (set! created (1+ created))
                     (hash-put! actors key actor)
                     actor)))
          (set! recent-module module)
          (set! recent-group group)
          (set! recent-key key)
          (set! recent-actor actor)
          actor)))
    (def id next-id)
    ;; Acquire message credit only after successful native publication.
    (thread-send actor (cons id message))
    (set! next-id (1+ next-id))
    (set! (deck-group-submitted group) (1+ (deck-group-submitted group)))
    id)
  (def (next-reply wait?)
    ;; Use Gerbil's selective mailbox traversal. Other services' replies and
    ;; unrelated owner messages retain their mailbox positions and ownership.
    (let scan ()
      (let (reply (if wait? (thread-mailbox-next) (mailbox-next)))
        (cond
          ((eq? reply mailbox-empty) (thread-mailbox-rewind) #f)
          ((or (and (deck-reply? reply) (eq? token (deck-reply-token reply)))
               (and (deck-notice? reply) (eq? token (deck-notice-token reply))))
           (thread-mailbox-extract-and-rewind)
           reply)
          (else (scan))))))
  (def (account reply)
    (when (deck-reply? reply)
      (let (group (deck-reply-group reply))
      (set! collected (1+ collected))
      (set! (deck-group-collected group) (1+ (deck-group-collected group))))))
  (def (collect-events maximum wait?)
    (assert-open)
    (unless (and (integer? maximum) (positive? maximum))
      (error "invalid Deck reply transfer capacity"))
    (let loop ((left maximum) (reply (next-reply wait?)) (ready []))
      (if (not reply) (list->vector (reverse ready))
        (begin
          (account reply)
          (let (ready (cons reply ready))
            (if (= left 1) (list->vector (reverse ready))
              (loop (1- left) (next-reply #f) ready)))))))
  (def (snapshot) (u64vector created retired (1- next-id) collected))
  (def (activate-group! key)
    (assert-open)
    (when (hash-key? groups key) (error "Deck Module is already active"))
    (hash-put! groups key (make-deck-group (make-hash-table) 0 0))
    #t)
  (def (retire-group! key)
    (assert-open)
    (def group (or (hash-get groups key) (error "Deck Module is not active")))
    (unless (= (deck-group-submitted group) (deck-group-collected group)) (error "Deck Module still owns messages"))
    (def actors (hash-values (deck-group-actors group)))
    (for-each (lambda (actor) (thread-send actor 'stop)) actors)
    (for-each thread-join! actors)
    (hash-remove! groups key)
    (when (eq? recent-group group)
      (set! recent-module #f) (set! recent-group #f) (set! recent-key #f) (set! recent-actor #f))
    (set! retired (+ retired (length actors)))
    ;; The Module's clock has joined before this boundary. Discard only its
    ;; already-published notices; foreign mailbox positions remain untouched.
    (let scan ()
      (let (event (mailbox-next))
        (cond
          ((eq? event mailbox-empty) (thread-mailbox-rewind))
          ((and (deck-notice? event) (eq? token (deck-notice-token event))
                (equal? key (deck-notice-module event)))
           (thread-mailbox-extract-and-rewind) (scan))
          (else (scan)))))
    (u64vector (length actors) (length actors)
               (deck-group-submitted group) (deck-group-collected group)))
  (def (notify-owner! kind module id due observed)
    (thread-send owner (make-deck-notice token kind module id due observed)))
  (def (stop)
    (assert-open)
    ;; Already admitted messages retire even when the host cannot decode a reply.
    (let drain ()
      (when (< collected (1- next-id))
        (account (next-reply #t))
        (drain)))
    (for-each retire-group! (hash-keys groups))
    (set! closed? #t)
    (snapshot))
  (.o submit: dispatch
      collect: (lambda (maximum) (collect-events maximum (< collected (1- next-id))))
      poll: (lambda (maximum) (collect-events maximum #f))
      wait: (lambda (maximum) (collect-events maximum #t))
      activate: activate-group! retire: retire-group! notify: notify-owner!
      statistics: snapshot close: stop))
