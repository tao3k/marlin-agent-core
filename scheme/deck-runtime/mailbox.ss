;;; Identity-owned Gerbil Actors with reusable mailboxes and independent replies.

(import (only-in :clan/poo/object .o)
        (only-in :std/actor/interaction mailbox-next mailbox-empty))

(export open-deck-mailboxes
        deck-reply-id deck-reply-failed? deck-reply-value)

(defstruct deck-reply (token id failed? value))

(def (open-deck-mailboxes route handler)
  (def owner (current-thread))
  (def actors (make-hash-table))
  (def token (gensym 'deck-mailbox))
  (def next-id 1)
  (def pending 0)
  (def collected 0)
  (def retired 0)
  (def closed? #f)
  (def recent-key #f)
  (def recent-actor #f)
  (def (assert-owner)
    (unless (eq? owner (current-thread))
      (error "Deck mailboxes belong to their opening Scheme thread")))
  (def (assert-open)
    (assert-owner)
    (when closed? (error "Deck mailboxes are closed")))
  (def (serve)
    (def message #f)
    ;; Keep the exception continuation for the receiving Actor's lifetime.
    ;; A handler failure publishes its own reply and reopens the same mailbox
    ;; loop. Successful messages allocate no new exception continuation.
    (let restart ()
      (with-catch
        (lambda (failure)
          (unless message (raise failure))
          (thread-send owner (make-deck-reply token (car message) #t failure))
          (set! message #f)
          (restart))
        (lambda ()
          (let loop ()
            (set! message (thread-receive))
            (unless (eq? message 'stop)
              (let (value (handler (cdr message)))
                (thread-send owner (make-deck-reply token (car message) #f value)))
              (set! message #f)
              (loop)))))))
  (def (dispatch message)
    (assert-open)
    (when (and (not (fixnum? next-id)) (> next-id 18446744073709551615))
      (error "Deck message identity exhausted"))
    (def key (route message))
    (def actor
      (if (and recent-actor (equal? key recent-key)) recent-actor
        (let (actor
               (or (hash-get actors key)
                   (let (actor (spawn serve))
                     (hash-put! actors key actor)
                     actor)))
          (set! recent-key key)
          (set! recent-actor actor)
          actor)))
    (def id next-id)
    ;; Acquire message credit only after successful native publication.
    (thread-send actor (cons id message))
    (set! next-id (1+ next-id))
    (set! pending (1+ pending))
    id)
  (def (next-reply wait?)
    ;; Use Gerbil's selective mailbox traversal. Other services' replies and
    ;; unrelated owner messages retain their mailbox positions and ownership.
    (let scan ()
      (let (reply (if wait? (thread-mailbox-next) (mailbox-next)))
        (cond
          ((eq? reply mailbox-empty) (thread-mailbox-rewind) #f)
          ((and (deck-reply? reply) (eq? token (deck-reply-token reply)))
           (thread-mailbox-extract-and-rewind)
           reply)
          (else (scan))))))
  (def (collect-replies maximum)
    (assert-open)
    (unless (and (integer? maximum) (positive? maximum))
      (error "invalid Deck reply transfer capacity"))
    (if (zero? pending) #()
      (let loop ((left maximum) (reply (next-reply #t)) (ready []))
        (set! pending (1- pending))
        (set! collected (1+ collected))
        (let (ready (cons reply ready))
          (if (= left 1) (list->vector (reverse ready))
            (let (next (next-reply #f))
              (if next (loop (1- left) next ready)
                (list->vector (reverse ready)))))))))
  (def (snapshot)
    (u64vector (hash-length actors) retired (1- next-id) collected))
  (def (stop)
    (assert-open)
    ;; Already admitted messages retire even when the host cannot decode a reply.
    (let drain ()
      (when (positive? pending)
        (next-reply #t)
        (set! pending (1- pending))
        (set! collected (1+ collected))
        (drain)))
    (for-each (lambda (actor) (thread-send actor 'stop)) (hash-values actors))
    (for-each thread-join! (hash-values actors))
    (set! retired (hash-length actors))
    (set! closed? #t)
    (snapshot))
  (.o submit: dispatch collect: collect-replies statistics: snapshot close: stop))
