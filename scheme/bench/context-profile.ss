;;; Component probes call the existing Lab and Marlin operations unchanged.
package: marlin-benchmark
(import (only-in :clan/poo/object .get)
        (only-in :clan/poo/mop validate)
        (only-in :marlin-benchmark/compiler-roots compiler-roots-snapshot)
        (only-in :marlin-benchmark/mailbox mailbox-clock-ns)
        (only-in :agentic-ai-lab/modules/ai-agentic-context/types
                 agentic-ai-lab-ai-agentic-context-scope-shape? AiAgenticContextAdmissionType)
        (only-in :agentic-ai-lab/modules/ai-agentic-context/funs-scope
                 agentic-ai-lab-ai-agentic-context-scope-admit)
        (only-in :marlin-agent-core/init marlin-agent-core.init.exports))
(export run-context-profile run-context-retention-profile)
(extern context-profile-phase!)
(begin-foreign
  (namespace ("marlin-benchmark/context-profile#" context-profile-phase!))
  (c-declare "unsigned int marlin_context_profile_phase = 0;
static void marlin_context_set_phase(int phase) { marlin_context_profile_phase = (unsigned)phase; }")
  (define context-profile-phase! (c-lambda (int) void "marlin_context_set_phase")))

(def (run-context-profile batches)
  (def context (.get marlin-agent-core.init.exports Marlin context))
  (def decode (.get context bridge decode-batch))
  (def encode (.get context bridge encode-scopes))
  (def admit (.get context admit-scope))
  (def observations [])
  (def (monotonic-seconds) (/ (mailbox-clock-ns) 1000000000.))
  (def (prepare) (vector-map decode batches))
  (def (map-rows operation groups)
    (vector-map (lambda (rows) (vector-map operation rows)) groups))
  (def (force groups)
    (map-rows (lambda (scope) (.get scope semantic-digest)) groups))
  (def (measure tag operation)
    (context-profile-phase! (1+ tag))
    (def begin (monotonic-seconds))
    (def before (##process-statistics))
    (def result (operation))
    (def end (monotonic-seconds))
    (def after (##process-statistics))
    (context-profile-phase! 0)
    (set! observations
      (cons (vector (u64vector tag (inexact->exact (round (* (- end begin) 1000000000.))))
                    before after) observations))
    result)
  (measure 0 prepare)
  (let (inputs (prepare))
    (measure 1 (lambda ()
      (map-rows (lambda (request)
        (unless (agentic-ai-lab-ai-agentic-context-scope-shape? request)
          (error "profile input failed Lab validation")) #t) inputs))))
  (let (inputs (prepare))
    (measure 2 (lambda () (map-rows agentic-ai-lab-ai-agentic-context-scope-admit inputs))))
  (let (inputs (prepare))
    (measure 3 (lambda () (map-rows admit inputs))))
  (let (scopes (map-rows admit (prepare)))
    (measure 4 (lambda () (force scopes))))
  (let (scopes (map-rows admit (prepare)))
    (force scopes)
    (measure 5 (lambda () (vector-map encode scopes))))
  (def output
    (measure 6 (lambda ()
      (vector-map (lambda (input)
        (let (scopes (vector-map admit (decode input)))
          (vector-for-each (lambda (scope) (.get scope semantic-digest)) scopes)
          (encode scopes))) batches))))
  (def rechecked (validate AiAgenticContextAdmissionType admit))
  (let (inputs (prepare))
    (measure 7 (lambda () (map-rows rechecked inputs))))
  (def deck ((.get marlin-agent-core.init.exports Marlin deck-runtime open) admit encode))
  (def actor-output
    (measure 8 (lambda ()
      (vector-map (lambda (rows)
        (def ids ((.get deck submit-module-batch) 1 rows))
        (def packets [])
        (let drain ((left (vector-length rows)))
          (when (positive? left)
            (let (packet ((.get deck collect) 64))
              (set! packets (cons packet packets))
              (drain (- left (u64vector-length (vector-ref packet 0)))))))
        (vector ids (reverse packets))) (prepare)))))
  ;; Validate every Actor result outside all timed/allocation phases. Counting
  ;; replies alone would accept failed handlers or changed digest contents.
  (let batches ((index 0))
    (when (< index (vector-length actor-output))
      (let* ((batch (vector-ref actor-output index))
             (expected (vector-ref output index))
             (ids (vector-ref batch 0))
             (seen (make-u8vector (u64vector-length ids) 0))
             (first (u64vector-ref ids 0)))
      (for-each
        (lambda (packet)
          (def returned (vector-ref packet 0))
          (def statuses (vector-ref packet 1))
          (def digests (vector-ref packet 2))
          (unless (and (= (u64vector-length returned) (u8vector-length statuses))
                       (= (* 32 (u64vector-length returned)) (u8vector-length digests))
                       (zero? (u64vector-length (vector-ref packet 3))))
            (error "profile Actor packet shape changed"))
          (let replies ((row 0))
            (when (< row (u64vector-length returned))
              (let (offset (- (u64vector-ref returned row) first))
              (unless (and (<= 0 offset) (< offset (u64vector-length ids))
                           (= (u64vector-ref returned row) (u64vector-ref ids offset))
                           (zero? (u8vector-ref seen offset))
                           (zero? (u8vector-ref statuses row)))
                (error "profile Actor identity/status mismatch"))
              (u8vector-set! seen offset 1)
              (let bytes ((byte 0))
                (when (< byte 32)
                  (unless (= (u8vector-ref digests (+ (* row 32) byte))
                             (u8vector-ref expected (+ (* offset 32) byte)))
                    (error "profile Actor digest mismatch"))
                  (bytes (1+ byte))))
              (replies (1+ row))))))
        (vector-ref batch 1))
      (let complete ((row 0))
        (when (< row (u8vector-length seen))
          (unless (= (u8vector-ref seen row) 1) (error "profile Actor result missing"))
          (complete (1+ row))))
      (batches (1+ index)))))
  ((.get deck close))
  (vector (list->vector (reverse observations)) output
          (u64vector (if (eq? admit rechecked) 1 0)
                     (if (eq? admit agentic-ai-lab-ai-agentic-context-scope-admit) 1 0))))

;; Separate forced-GC diagnostic. This function is NEVER called by the timed
;; production or component workloads, and its times are not performance evidence.
(def (run-context-retention-profile _)
  (def snapshots [])
  (def (snapshot)
    (def roots (compiler-roots-snapshot))
    ;; The traversal's temporary tables die before the forced diagnostic GC.
    (##gc)
    (set! snapshots
      (cons (vector (##process-statistics) (vector-ref roots 0) (vector-ref roots 1)) snapshots)))
  (snapshot)
  (context-profile-phase! 10)
  (def lab (.get marlin-agent-core.init.exports Lab ai-agentic-context))
  (context-profile-phase! 0)
  (snapshot)
  (def context (.get marlin-agent-core.init.exports Marlin context))
  (snapshot)
  (def published (.get marlin-agent-core.init.exports Marlin deck-runtime))
  (snapshot)
  (def runtime ((.get published open) (.get context admit-scope) (.get context bridge encode-scopes)))
  (snapshot)
  (def counts ((.get runtime close)))
  (set! runtime #f) (set! context #f) (set! published #f) (set! lab #f)
  (snapshot)
  (vector (list->vector (reverse snapshots)) counts))
