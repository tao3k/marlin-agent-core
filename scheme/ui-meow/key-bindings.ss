(import "./syntax.ss")
(export UiMeowScope)

(define-key-bindings UiMeowScope
  keypad:
  ;; Every Doom SPC Leader key aliases its canonical native Emacs keybinding so
  ;; Normal-mode SPC muscle memory and Insert/Global Emacs chords stay 1:1 aligned.
  (meow-keypad
    ((SPC x) (M-x))
    ((SPC SPC) (M-x))
    ((SPC b b) (C-x b))
    ((SPC r) (C-r))
    ((SPC s) (C-s))
    ((SPC h) (C-h r))
    ((SPC #\~) (C-x p))
    ((SPC w v) (C-x #\3))
    ((SPC w s) (C-x #\2))
    ((SPC w w) (C-x o))
    ((SPC w W) (C-x O))
    ((SPC w d) (C-x #\0))
    ((SPC w c) (C-x #\0))
    ((SPC w o) (C-x #\1))
    ((SPC w #\=) (C-x #\+))
    ((SPC w e) (C-x #\+))
    ((SPC w u) (C-c u))
    ((SPC w U) (C-c U))
    ((SPC w t) (C-x w d))
    ((SPC w p) (C-x p))
    ((SPC w #\1) (M-1))
    ((SPC w #\2) (M-2))
    ((SPC w #\3) (M-3))
    ((SPC w #\4) (M-4))
    ((SPC w #\5) (M-5))
    ((SPC w #\6) (M-6))
    ((SPC w #\7) (M-7))
    ((SPC w #\8) (M-8))
    ((SPC w #\9) (M-9))
    ((SPC TAB n) (C-x t #\2))
    ((SPC TAB d) (C-x t #\0))
    ((SPC TAB #\]) (C-x t o))
    ((SPC TAB #\[) (C-x t O))
    ((SPC t z) (C-x z))
    ((SPC t Z) (C-x Z))
    ((SPC q q) (C-x C-c)))
  ;; Native Emacs global-map / ctl-x-map / C-c / C-h / M-1..9 bindings:
  ;; active identically in BOTH Insert mode AND Normal mode!
  (meow-global
    ((C-g) cancel "Cancel or return")
    ((C-r) history-search "Search prompts")
    ((C-s) helm "Open Helm search")
    ((M-p) previous-prompt "Previous prompt")
    ((M-n) next-prompt "Next prompt")
    ((C-n) insert-newline "Insert newline")
    ((C-b) backward-char "Move one character left")
    ((C-f) forward-char "Move one character right")
    ((C-d) delete-char "Delete next character")
    ((C-a) line-start "Start of line")
    ((C-e) line-end "End of line")
    ((C-h r) help "Open Marlin help")
    ((C-h #\?) help "Open Marlin help")
    ;; Native Emacs ctl-x-map (C-x): buffers, windows, popups, tab-bar workspaces, zen, quit
    ((C-x b) switch-buffer "Switch buffer")
    ((C-x #\0) window-delete "Close window or workspace")
    ((C-x #\1) window-only "Delete other windows")
    ((C-x #\2) window-split-below "Split window below")
    ((C-x #\3) window-split-right "Split window right")
    ((C-x o) window-other "Other window")
    ((C-x O) window-prev "Previous window")
    ((C-x #\+) window-balance "Balance windows")
    ((C-x p) popup-toggle "Toggle popup drawer")
    ((C-x w d) window-toggle-dedicated "Toggle window dedicated")
    ((C-x t #\2) workspace-new "New workspace")
    ((C-x t #\0) workspace-kill "Kill workspace")
    ((C-x t o) workspace-next "Next workspace")
    ((C-x t O) workspace-prev "Previous workspace")
    ((C-x z) zen-mode "Toggle Zen Writeroom")
    ((C-x Z) zen-fullscreen "Toggle Zen Fullscreen")
    ((C-x C-c) quit "Exit Marlin")
    ;; Native Emacs winner-mode (C-c u / C-c U) & direct winum jump (M-1..M-9)
    ((C-c u) winner-undo "Undo window layout")
    ((C-c U) winner-redo "Redo window layout")
    ((M-1) winum-select-window-1 "Select window 1")
    ((M-2) winum-select-window-2 "Select window 2")
    ((M-3) winum-select-window-3 "Select window 3")
    ((M-4) winum-select-window-4 "Select window 4")
    ((M-5) winum-select-window-5 "Select window 5")
    ((M-6) winum-select-window-6 "Select window 6")
    ((M-7) winum-select-window-7 "Select window 7")
    ((M-8) winum-select-window-8 "Select window 8")
    ((M-9) winum-select-window-9 "Select window 9"))
  (meow-insert
    ((ESC) normal-mode "Enter Normal mode")
    ((M-x) open-commands "Open commands"))
  (meow-normal
    ((M-x) open-commands "Open commands")
    ((C-o) open-commands "Open commands")
    ((ESC) cancel "Cancel or return")
    ((i) insert-mode "Insert before cursor or selection")
    ((a) append-insert "Insert after cursor or selection")
    ((I) open-line-above "Open line above and insert")
    ((A) open-line-below "Open line below and insert")
    ((h) backward-char "Move left")
    ((j) next-line "Move down")
    ((k) previous-line "Move up")
    ((l) forward-char "Move right")
    ((#\$) line-end "End of line")
    ((RET) next-line "Move down")
    ((BACKSPACE) backward-char "Move left")
    ((DELETE) delete-char "Delete character")
    ((SPC t t) switch-themes "Switch theme")
    ((SPC t i) task-tab-index "Focus pinned Tasks Index tab")
    ((SPC t n) task-tab-next "Focus next active TaskActor tab")
    ((SPC t p) task-tab-prev "Focus previous active TaskActor tab")
    ;; Additional Doom SPC w / SPC TAB bindings beyond C-x direct aliases
    ((SPC w x) window-swap "Swap windows")
    ((SPC w l) window-widen "Widen window")
    ((SPC w h) window-narrow "Narrow window")
    ((SPC w r) popup-raise "Raise popup to window")
    ((SPC TAB N) workspace-new-named "New named workspace")
    ((SPC TAB #\1) workspace-switch-1 "Switch to workspace 1")
    ((SPC TAB #\2) workspace-switch-2 "Switch to workspace 2")
    ((SPC TAB #\3) workspace-switch-3 "Switch to workspace 3")
    ((SPC TAB #\4) workspace-switch-4 "Switch to workspace 4")
    ((SPC TAB #\0) workspace-switch-final "Switch to final workspace"))
  (meow-edit
    ((w) select-word "Select word")
    ((b) select-previous-word "Select back to previous word")
    ((e) select-next-word "Select through next word")
    ((x) select-line "Select or extend by line")
    ((f) (read-selection-character through forward) "Select through next character")
    ((t) (read-selection-character before forward) "Select up to next character")
    ((F) (read-selection-character through backward) "Select through previous character")
    ((T) (read-selection-character before backward) "Select up to previous character")
    ((H) extend-left "Extend selection left")
    ((J) extend-down "Extend selection down")
    ((K) extend-up "Extend selection up")
    ((L) extend-right "Extend selection right")
    ((#\;) reverse-selection "Reverse selection")
    ((g) clear-selection "Clear selection")
    ((z) previous-selection "Restore previous selection")
    ((d) delete-char "Delete selection or next character")
    ((D) delete-backward "Delete selection or previous character")
    ((s) cut-selection "Cut selection")
    ((c) change-selection "Replace selection and enter Insert mode")
    ((y) copy-selection "Copy selection")
    ((p) paste-selection "Paste")
    ((u) undo "Undo edit"))
  (meow-expand accent
    (#\1 1 #f) (#\2 2 #f) (#\3 3 #f) (#\4 4 #f) (#\5 5 #f)
    (#\6 6 #f) (#\7 7 #f) (#\8 8 #f) (#\9 9 #f) (#\0 10 #t))
  (meow-things
    (r #\( #\) "parentheses")
    (s #\[ #\] "square brackets")
    (c #\{ #\} "braces")
    (g #\" #\" "double quotes")
    (t #\` #\` "backticks")))
