(import "./syntax.ss")
(export UiMeowScope)

(define-key-bindings UiMeowScope
  keypad:
  ;; Every Doom SPC Leader key aliases its canonical native Emacs keybinding so
  ;; Normal-mode SPC muscle memory and Insert/Global Emacs chords stay 1:1 aligned.
  (meow-keypad
    ((SPC x) (M-x))
    ((SPC SPC) (M-x))
    ((SPC f f) (C-x C-f))
    ((SPC f p) (C-c p f))
    ((SPC f r) (C-x C-r))
    ((SPC p f) (C-c p f))
    ((SPC p p) (C-c p p))
    ((SPC p #\/) (C-c #\/))
    ((SPC #\/) (C-c #\/))
    ((SPC #\,) (C-x b))
    ((SPC l) (C-c l))
    ((SPC i) (C-c i))
    ((SPC RET) (C-x r b))
    ((SPC b m) (C-x r b))
    ((SPC b M) (C-x r m))
    ((SPC b b) (C-x b))
    ((SPC b B) (C-x #\4 b))
    ((SPC b d) (C-x k))
    ((SPC b K) (C-x #\4 #\0))
    ((SPC b R) (C-x x r))
    ((SPC b z) (C-c z))
    ((SPC b i) (C-c b))
    ((SPC b #\[) (C-c #\[))
    ((SPC b #\]) (C-c #\]))
    ((SPC r) (C-r))
    ((SPC s) (C-s))
    ((SPC h r) (C-h r))
    ((SPC h m) (C-h m))
    ((SPC h k) (C-h k))
    ((SPC h f) (C-h f))
    ((SPC h b) (C-h b))
    ((SPC h l) (C-h l))
    ((SPC #\.) (C-c e))
    ((SPC m #\.) (C-c #\.))
    ((SPC #\~) (C-x p))
    ((SPC w v) (C-x #\3))
    ((SPC w s) (C-x #\2))
    ((SPC w w) (C-x o))
    ((SPC w W) (C-x O))
    ((SPC w d) (C-x #\0))
    ((SPC w c) (C-x #\0))
    ((SPC w o) (C-x #\1))
    ((SPC w #\=) (C-x #\+))
    ((SPC w e) (C-x #\+))
    ((SPC w u) (C-c u))
    ((SPC w U) (C-c U))
    ((SPC w t) (C-x w d))
    ((SPC w p) (C-x p))
    ((SPC w #\1) (M-1))
    ((SPC w #\2) (M-2))
    ((SPC w #\3) (M-3))
    ((SPC w #\4) (M-4))
    ((SPC w #\5) (M-5))
    ((SPC w #\6) (M-6))
    ((SPC w #\7) (M-7))
    ((SPC w #\8) (M-8))
    ((SPC w #\9) (M-9))
    ((SPC TAB n) (C-x t #\2))
    ((SPC TAB N) (C-x t N))
    ((SPC TAB d) (C-x t #\0))
    ((SPC TAB #\]) (C-x t o))
    ((SPC TAB #\[) (C-x t O))
    ((SPC TAB #\1) (C-x t #\1))
    ((SPC TAB #\2) (C-x t #\3))
    ((SPC TAB #\3) (C-x t #\4))
    ((SPC TAB #\4) (C-x t #\5))
    ((SPC TAB #\0) (C-x t #\9))
    ((SPC w x) (C-x w x))
    ((SPC w l) (C-x w l))
    ((SPC w h) (C-x w h))
    ((SPC w r) (C-x w r))
    ((SPC w m) (C-x w m))
    ((SPC w T) (C-x w t))
    ((SPC w R) (C-x r w))
    ((SPC w J) (C-x r j))
    ((SPC w L) (C-x r l))
    ((SPC t t) (C-x t t))
    ((SPC t d) (C-c t d))
    ((SPC t a) (C-c t a))
    ((SPC t r) (C-c t r))
    ((SPC t l) (C-c t l))
    ((SPC t i) (C-c t i))
    ((SPC t n) (C-c t n))
    ((SPC t p) (C-c t p))
    ((SPC t z) (C-x z))
    ((SPC t Z) (C-x Z))
    ;; Canonical Magit dual-bindings: Doom SPC g <-> Emacs C-x g / C-x M-g / C-c g / C-c M-g
    ((SPC g g) (C-x g))
    ((SPC g d) (C-x M-g))
    ((SPC g a) (C-c g))
    ((SPC g f) (C-c M-g))
    ((SPC q q) (C-x C-c)))
  ;; Native Emacs global-map / ctl-x-map / C-c / C-h / M-1..9 bindings:
  ;; active identically in BOTH Insert mode AND Normal mode!
  (meow-global
    ((C-g) cancel "Cancel or return")
    ((C-r) history-search "Search prompts")
    ((C-s) helm "Open Helm search")
    ((M-p) previous-prompt "Previous prompt")
    ((M-n) next-prompt "Next prompt")
    ((C-n) insert-newline "Insert newline")
    ((C-b) backward-char "Move one character left")
    ((C-f) forward-char "Move one character right")
    ((C-d) delete-char "Delete next character")
    ((C-a) line-start "Start of line")
    ((C-e) line-end "End of line")
    ((C-h r) help "Open Marlin help")
    ((C-h #\?) help "Open Marlin help")
    ((C-h m) describe-mode "Describe current Major/Minor/Polymode")
    ((C-h k) describe-key "Describe key or chord")
    ((C-h f) describe-function "Describe command or function")
    ((C-h b) describe-bindings "Describe all active keybindings")
    ((C-h l) view-lossage "View recent keystrokes and command log")
    ;; Native Emacs ctl-x-map (C-x): files, buffers, windows, popups, tab-bar workspaces, zen, quit
    ((C-x C-f) find-file "Find file (Vertico directory)")
    ((C-x C-r) recentf-open-files "Open recent file")
    ((C-x b) switch-buffer "Switch buffer")
    ((C-x #\4 b) switch-to-buffer-other-window "Switch buffer in other window")
    ((C-x #\4 #\0) kill-buffer-and-window "Kill buffer and close window")
    ((C-x C-b) hydra-buffers "Open buffers group")
    ((C-x k) kill-buffer "Kill current buffer")
    ((C-x r w) window-configuration-to-register "Save window layout to register")
    ((C-x r j) jump-to-register "Jump to saved register layout")
    ((C-x r l) list-registers "List saved window registers")
    ((C-x r m) bookmark-set "Set Emacs bookmark")
    ((C-x r b) bookmark-jump "Jump to Emacs bookmark")
    ((C-x #\0) window-delete "Close window or workspace")
    ((C-x #\1) window-only "Delete other windows")
    ((C-x #\2) window-split-below "Split window below")
    ((C-x #\3) window-split-right "Split window right")
    ((C-x o) window-other "Other window")
    ((C-x O) window-prev "Previous window")
    ((C-x #\+) window-balance "Balance windows")
    ((C-x p) popup-toggle "Toggle popup drawer")
    ((C-x g) magit-status "Open Magit status (*magit*)")
    ((C-x M-g) magit-dispatch "Open Magit dispatch (?)")
    ((C-x w d) window-toggle-dedicated "Toggle window dedicated")
    ((C-x w x) window-swap "Swap windows")
    ((C-x w l) window-widen "Widen window")
    ((C-x w h) window-narrow "Narrow window")
    ((C-x w r) popup-raise "Raise popup to window")
    ((C-x w m) window-zoom-toggle "Zoom / restore focused window")
    ((C-x w t) window-transpose-layout "Transpose split orientation (V <-> H)")
    ((C-x x r) rename-buffer "Rename active buffer")
    ((C-x t #\2) workspace-new "New workspace")
    ((C-x t N) workspace-new-named "New named workspace")
    ((C-x t #\0) workspace-kill "Kill workspace")
    ((C-x t o) workspace-next "Next workspace")
    ((C-x t O) workspace-prev "Previous workspace")
    ((C-x t #\1) workspace-switch-1 "Switch to workspace 1")
    ((C-x t #\3) workspace-switch-2 "Switch to workspace 2")
    ((C-x t #\4) workspace-switch-3 "Switch to workspace 3")
    ((C-x t #\5) workspace-switch-4 "Switch to workspace 4")
    ((C-x t #\9) workspace-switch-final "Switch to final workspace")
    ((C-x t t) switch-themes "Switch theme")
    ((C-x z) zen-mode "Toggle Zen Writeroom")
    ((C-x Z) zen-fullscreen "Toggle Zen Fullscreen")
    ((C-x C-c) quit "Exit Marlin")
    ;; Native Emacs winner-mode (C-c u / C-c U), Magit AI audit (C-c g / C-c M-g), Task tabs (C-c t)
    ((C-c u) winner-undo "Undo window layout")
    ((C-c U) winner-redo "Redo window layout")
    ((C-c g) magit-ai-audit "Open Magit AI Code Audit (50/50 split)")
    ((C-c M-g) magit-file-dispatch "Magit diff & Aitia audit dispatch")
    ((C-c b) ibuffer "Open *Ibuffer* grouped by Major Mode")
    ((C-c #\[) previous-buffer "Switch to previous buffer")
    ((C-c #\]) next-buffer "Switch to next buffer")
    ((C-c z) bury-buffer "Bury current buffer to end of ring")
    ((C-c e) embark-act "Embark contextual actions at point")
    ((C-c #\.) repeat-last-command "Repeat last executed command")
    ((C-c p f) project-find-file "Find file in current Git/jj project")
    ((C-c p p) project-switch-project "Switch active Git/jj project")
    ((C-c #\/) consult-ripgrep "Project grep (ASP+Tantivy)")
    ((C-c l) consult-line "Search lines in buffer")
    ((C-c i) consult-imenu "Jump to symbol (ASP Imenu)")
    ((C-c t d) toggle-dedicated-window-mode "Toggle dedicated-window-mode")
    ((C-c t a) toggle-aitia-audit-mode "Toggle aitia-audit-minor-mode")
    ((C-c t r) toggle-read-only-mode "Toggle read-only-mode")
    ((C-c t l) toggle-llm-assist-mode "Toggle llm-inline-assist-mode")
    ((C-c t i) task-tab-index "Focus pinned Tasks Index tab")
    ((C-c t n) task-tab-next "Focus next active TaskActor tab")
    ((C-c t p) task-tab-prev "Focus previous active TaskActor tab")
    ((M-1) winum-select-window-1 "Select window 1")
    ((M-2) winum-select-window-2 "Select window 2")
    ((M-3) winum-select-window-3 "Select window 3")
    ((M-4) winum-select-window-4 "Select window 4")
    ((M-5) winum-select-window-5 "Select window 5")
    ((M-6) winum-select-window-6 "Select window 6")
    ((M-7) winum-select-window-7 "Select window 7")
    ((M-8) winum-select-window-8 "Select window 8")
    ((M-9) winum-select-window-9 "Select window 9"))
  (meow-insert
    ((ESC) normal-mode "Enter Normal mode")
    ((M-x) open-commands "Open commands"))
  (meow-normal
    ((M-x) open-commands "Open commands")
    ((C-o) open-commands "Open commands")
    ((ESC) cancel "Cancel or return")
    ((i) insert-mode "Insert before cursor or selection")
    ((a) append-insert "Insert after cursor or selection")
    ((I) open-line-above "Open line above and insert")
    ((A) open-line-below "Open line below and insert")
    ((h) backward-char "Move left")
    ((j) next-line "Move down")
    ((k) previous-line "Move up")
    ((l) forward-char "Move right")
    ((#\$) line-end "End of line")
    ((RET) next-line "Move down")
    ((BACKSPACE) backward-char "Move left")
    ((DELETE) delete-char "Delete character"))
  (meow-edit
    ((w) select-word "Select word")
    ((b) select-previous-word "Select back to previous word")
    ((e) select-next-word "Select through next word")
    ((x) select-line "Select or extend by line")
    ((f) (read-selection-character through forward) "Select through next character")
    ((t) (read-selection-character before forward) "Select up to next character")
    ((F) (read-selection-character through backward) "Select through previous character")
    ((T) (read-selection-character before backward) "Select up to previous character")
    ((H) extend-left "Extend selection left")
    ((J) extend-down "Extend selection down")
    ((K) extend-up "Extend selection up")
    ((L) extend-right "Extend selection right")
    ((#\;) reverse-selection "Reverse selection")
    ((g) clear-selection "Clear selection")
    ((z) previous-selection "Restore previous selection")
    ((d) delete-char "Delete selection or next character")
    ((D) delete-backward "Delete selection or previous character")
    ((s) cut-selection "Cut selection")
    ((c) change-selection "Replace selection and enter Insert mode")
    ((y) copy-selection "Copy selection")
    ((p) paste-selection "Paste")
    ((u) undo "Undo edit"))
  (meow-expand accent
    (#\1 1 #f) (#\2 2 #f) (#\3 3 #f) (#\4 4 #f) (#\5 5 #f)
    (#\6 6 #f) (#\7 7 #f) (#\8 8 #f) (#\9 9 #f) (#\0 10 #t))
  (meow-things
    (r #\( #\) "parentheses")
    (s #\[ #\] "square brackets")
    (c #\{ #\} "braces")
    (g #\" #\" "double quotes")
    (t #\` #\` "backticks")))
