;;; Declarative Organization + GitOps Artifacts admission, bidirectional Org-Contract
;;; projection, multi-file directory materialization, and durable journal exchange.

(import (only-in :clan/poo/object .alist/sort .call .get .o .ref .slot? object?)
        (only-in :std/crypto/digest sha256)
        (only-in :std/encoding/hex hex-encode)
        (only-in :std/list/list delete-duplicates/hash every filter-map find)
        (only-in :std/string/misc string-trim)
        (only-in :marlin-agent-core/interface LabDurableJournal LabOrgDirectory)
        (only-in :marlin-agent-core/context-system/org-contract
                 marlin-context-org-contract-source)
        (only-in :marlin-agent-core/context-system/org-source
                 marlin-context-org-source-graph)
        (only-in "./objects.ss" DefaultArtifactCatalog))
(export artifacts-admit-record
        artifacts-project-context-org
        artifacts-inspect-context-org
        artifacts-plan-artifact-directory
        artifacts-materialize-artifact-directory!
        artifacts-validate-artifact-directory
        artifacts-exchange)

(def (nonempty-text? v)
  (and (string? v) (< 0 (string-length v) 512)))

(def (hex-id? value lengths)
  (and (string? value) (memv (string-length value) lengths)
       (andmap (lambda (char)
                 (or (char<=? #\0 char #\9) (char<=? #\a char #\f)))
               (string->list value))))

(def (sha256-hex text)
  (hex-encode (sha256 (string->utf8 text))))

(def (opt-slot obj key default)
  (if (and (object? obj) (.slot? obj key))
    (.ref obj key)
    default))

(def (ordered-entries catalog preferred-keys)
  (let* ((pairs (.alist/sort catalog))
         (preferred (filter-map (lambda (k) (assq k pairs)) preferred-keys))
         (extras (filter (lambda (kv) (not (memq (car kv) preferred-keys))) pairs)))
    (append preferred extras)))

(def (symbols->csv syms)
  (if (null? syms) ""
    (let loop ((rest (cdr syms)) (acc (symbol->string (car syms))))
      (if (null? rest) acc
        (loop (cdr rest) (string-append acc "," (symbol->string (car rest))))))))

(def (csv->symbols text)
  (if (or (not (string? text)) (string-empty? (string-trim text)))
    '()
    (let loop ((chars (string->list text)) (cur '()) (acc '()))
      (cond
       ((null? chars)
        (let (s (string-trim (list->string (reverse cur))))
          (reverse (if (string-empty? s) acc (cons (string->symbol s) acc)))))
       ((char=? (car chars) #\,)
        (let (s (string-trim (list->string (reverse cur))))
          (loop (cdr chars) '() (if (string-empty? s) acc (cons (string->symbol s) acc)))))
       (else (loop (cdr chars) (cons (car chars) cur) acc))))))

(def (admit-organization! org)
  (let ((roles (.get org roles))
        (agents (.get org agents)))
    (for-each
     (lambda (kv)
       (let loop ((key (car kv)) (seen '()))
         (when (memq key seen)
           (error "Cyclic Organization Agent hierarchy" key))
         (unless (.slot? agents key)
           (error "Unknown parent Agent in Organization" key))
         (let* ((agent (.ref agents key))
                (role-key (.get agent role))
                (parent (.get agent parent)))
           (unless (.slot? roles role-key)
             (error "Agent references undeclared Organization Role" key role-key))
           (when parent
             (unless (symbol? parent)
               (error "Organization Agent parent must be a symbol or #f" key parent))
             (loop parent (cons key seen))))))
     (.alist/sort agents))))

(def (incompatible-sod-roles? sod-pairs prod-role rev-role)
  ;; `sod-pairs` declares valid separation pairs or explicit forbidden overlaps;
  ;; same-agent review is always forbidden, and reviewer role must be review-eligible.
  (and (list? sod-pairs)
       (eq? prod-role rev-role)
       (find (lambda (p) (and (pair? p) (eq? (car p) prod-role) (eq? (cdr p) rev-role)))
             sod-pairs)))

(def (admit-artifact-record catalog spec)
  (unless (and (object? catalog) (object? spec))
    (error "Artifact admission requires POO catalog and record specification"))
  (let ((org (.get catalog organization))
        (kinds (.get catalog kinds))
        (domains (.get catalog domains))
        (collections (.get catalog collections)))
    (admit-organization! org)
    (let ((raw-kind (or (opt-slot spec 'artifact-kind #f) (opt-slot spec 'kind #f))))
      (unless (and (symbol? raw-kind) (.slot? kinds raw-kind))
        (error "Undeclared Artifact kind" raw-kind))
      (let* ((kind-def (.ref kinds raw-kind))
             (artifact-kind (.get kind-def kind))
             (media (.get kind-def media))
             (collection (or (opt-slot spec 'collection #f) (.get kind-def collection)))
             (_col (unless (and (symbol? collection) (.slot? collections collection))
                     (error "Undeclared Artifact Collection" collection)))
             (col-def (.ref collections collection))
             (_allowed (unless (memq artifact-kind (.get col-def allowed-kinds))
                         (error "Artifact kind is not admitted in Collection" artifact-kind collection)))
             (domain (.get col-def domain))
             (_dom (unless (and (symbol? domain) (.slot? domains domain))
                     (error "Collection references undeclared Artifact Domain" domain)))
             (directory (string-copy (.get col-def directory)))
             (producer (or (opt-slot spec 'producer #f) 'host-operator))
             (agents (.get org agents))
             (roles (.get org roles))
             (_prod (unless (and (symbol? producer) (.slot? agents producer))
                      (error "Undeclared producer Agent" producer)))
             (prod-def (.ref agents producer))
             (owner-role (.get prod-def role))
             (prod-role-def (.ref roles owner-role))
             (reviewer (opt-slot spec 'reviewer #f))
             (commit (opt-slot spec 'commit #f))
             (worktree (opt-slot spec 'worktree #f))
             (digest (opt-slot spec 'digest #f))
             (org-body (opt-slot spec 'org-body #f)))
        (unless (memq domain (.get prod-def domains))
          (error "Producer Agent outside Collection domain" producer domain))
        (unless (memq (.get kind-def required-capability) (.get prod-role-def capabilities))
          (error "Producer Role lacks required capability"
                 owner-role (.get kind-def required-capability)))
        (when (and (.get kind-def review-required?) (not reviewer))
          (error "Artifact kind requires independent Reviewer Agent" artifact-kind))
        (when reviewer
          (unless (and (symbol? reviewer) (.slot? agents reviewer))
            (error "Undeclared reviewer Agent" reviewer))
          (when (eq? reviewer producer)
            (error "Separation-of-duties violation: self-review refused" producer))
          (let* ((rev-def (.ref agents reviewer))
                 (rev-role (.get rev-def role))
                 (rev-role-def (.ref roles rev-role)))
            (when (equal? (.get rev-def identity) (.get prod-def identity))
              (error "Separation-of-duties violation: shared Agent identity" producer reviewer))
            (unless (.get rev-role-def review-eligible?)
              (error "Reviewer Role is not review-eligible" rev-role))
            (unless (memq domain (.get rev-def domains))
              (error "Reviewer Agent outside Collection domain" reviewer domain))
            (when (incompatible-sod-roles? (.get org sod-pairs) owner-role rev-role)
              (error "Separation-of-duties role conflict" owner-role rev-role))))
        (unless (and (hex-id? commit '(40 64))
                     (nonempty-text? worktree)
                     (hex-id? digest '(64)))
          (error "Invalid artifact commit, worktree, or sha256 digest"))
        (when org-body
          (unless (and (string? org-body) (equal? (sha256-hex org-body) digest))
            (error "Org artifact body sha256 does not match digest"))
          (let (cut (marlin-context-org-contract-source
                     (.o identity: (.get col-def index-file) generation: 1 source: org-body)))
            (unless (equal? (.get cut contract-identity) (.get kind-def contract-id))
              (error "Org artifact body CONTRACT_ID mismatch"
                     (.get cut contract-identity) (.get kind-def contract-id)))))
        (let ((kind 'marlin.artifact)
              (commit (string-copy commit))
              (worktree (string-copy worktree))
              (digest (string-copy digest))
              (producer-agent (string-copy (.get prod-def identity)))
              (reviewer-agent (and reviewer (string-copy (.get (.ref agents reviewer) identity))))
              (reviewer-role (and reviewer (.get (.ref agents reviewer) role)))
              (contract-id (string-copy (.get kind-def contract-id))))
          (.o kind artifact-kind media collection domain directory
              commit worktree digest
              producer producer-agent owner-role
              reviewer reviewer-agent reviewer-role
              contract-id))))))

(def (normalize-committed-row catalog entry)
  (cond
   ((and (object? entry) (.slot? entry 'id) (.slot? entry 'payload))
    (let ((id (string-copy (.get entry id)))
          (payload (admit-artifact-record catalog (.get entry payload))))
      (.o id payload)))
   ((object? entry)
    (let* ((payload (admit-artifact-record catalog entry))
           (id (.call LabDurableJournal hash (.call LabDurableJournal pack payload))))
      (.o id payload)))
   (else (error "Invalid committed artifact row" entry))))

(def (emit-artifact-headline! stars id record)
  (displayln stars " " (.get record artifact-kind))
  (displayln ":PROPERTIES:")
  (displayln ":ID: " id)
  (displayln ":ORG_NODE_KIND: artifact")
  (displayln ":ARTIFACT_KIND: " (.get record artifact-kind))
  (displayln ":MEDIA: " (.get record media))
  (displayln ":DOMAIN: " (.get record domain))
  (displayln ":COLLECTION: " (.get record collection))
  (displayln ":COLLECTION_DIR: " (.get record directory))
  (displayln ":WORKTREE_ID: " (.get record worktree))
  (displayln ":GIT_COMMIT: " (.get record commit))
  (displayln ":PRODUCER_KEY: " (.get record producer))
  (displayln ":PRODUCER_AGENT: " (.get record producer-agent))
  (displayln ":OWNER_ROLE: " (.get record owner-role))
  (when (.get record reviewer)
    (displayln ":REVIEWER_KEY: " (.get record reviewer))
    (displayln ":REVIEWER_AGENT: " (.get record reviewer-agent))
    (displayln ":REVIEWER_ROLE: " (.get record reviewer-role)))
  (displayln ":CONTRACT_ID: " (.get record contract-id))
  (displayln ":ARTIFACT: " (.get record digest))
  (displayln ":END:")
  (displayln "[[file:artifacts/" (.get record digest) "][Artifact]]"))

(def (project-context-org catalog rows)
  (admit-organization! (.get catalog organization))
  (let* ((normalized (map (cut normalize-committed-row catalog <>) rows))
         (org (.get catalog organization))
         (roles (ordered-entries (.get org roles)
                                 '(coordinator architect author verifier operator)))
         (agents (ordered-entries (.get org agents)
                                  '(lead architect worker verifier host-operator)))
         (domains (ordered-entries (.get catalog domains)
                                   '(shared worktree verification)))
         (collections (ordered-entries (.get catalog collections)
                                       '(topology evidence work patches receipts))))
    (call-with-output-string
      (lambda (port)
        (parameterize ((current-output-port port))
          (displayln ":PROPERTIES:")
          (displayln ":ID: " (.get catalog identity) "-root")
          (displayln ":CONTRACT_ID: " (.get catalog contract-id))
          (displayln ":CONTRACT_REVISION: " (.get catalog contract-revision))
          (displayln ":PROJECT_ID: " (.get catalog project))
          (displayln ":ORGANIZATION_ID: " (.get org identity))
          (displayln ":END:")
          (displayln "#+title: Shared Git Context")
          (displayln "#+language: en")
          (newline)
          (displayln "* Contract")
          (displayln ":PROPERTIES:")
          (displayln ":CONTRACT_ID: " (.get catalog contract-id))
          (displayln ":CONTRACT_SCOPE: document")
          (displayln ":END:")
          (newline)
          (displayln "#+begin_src scheme :org-contract")
          (displayln "(assert-org-element \"gitops-artifacts.file-contract\" error")
          (displayln "  (bindings")
          (displayln "   (bind file-properties (org-elements property-drawer (child-of scope))))")
          (displayln "  (org-elements node-property (child-of file-properties)")
          (displayln "                (property key \"CONTRACT_ID\")")
          (displayln "                (property value \"" (.get catalog contract-id) "\"))")
          (displayln "  (expect exactly 1))")
          (newline)
          (displayln "(assert-org-element \"gitops-artifacts.organization-roles\" error")
          (displayln "  (bindings)")
          (displayln "  (org-elements node-property (descendant-of scope)")
          (displayln "                (property key \"ORG_NODE_KIND\")")
          (displayln "                (property value \"role\"))")
          (displayln "  (expect at-least 1))")
          (newline)
          (displayln "(assert-org-element \"gitops-artifacts.collections\" error")
          (displayln "  (bindings)")
          (displayln "  (org-elements node-property (descendant-of scope)")
          (displayln "                (property key \"ORG_NODE_KIND\")")
          (displayln "                (property value \"collection\"))")
          (displayln "  (expect at-least 1))")
          (displayln "#+end_src")
          (newline)
          (displayln "* Organization Architecture")
          (displayln ":PROPERTIES:")
          (displayln ":CUSTOM_ID: org-architecture")
          (displayln ":ORG_NODE_KIND: organization-root")
          (displayln ":ORGANIZATION_ID: " (.get org identity))
          (displayln ":END:")
          (for-each
           (lambda (kv)
             (let ((rkey (car kv)) (rdef (cdr kv)))
               (displayln "** Role " rkey)
               (displayln ":PROPERTIES:")
               (displayln ":CUSTOM_ID: role-" rkey)
               (displayln ":ORG_NODE_KIND: role")
               (displayln ":ROLE_KEY: " rkey)
               (displayln ":ROLE_ID: " (.get rdef identity))
               (displayln ":CAPABILITIES: " (symbols->csv (.get rdef capabilities)))
               (displayln ":REVIEW_ELIGIBLE: " (if (.get rdef review-eligible?) "true" "false"))
               (displayln ":END:")))
           roles)
          (for-each
           (lambda (kv)
             (let ((akey (car kv)) (adef (cdr kv)))
               (displayln "** Agent " akey)
               (displayln ":PROPERTIES:")
               (displayln ":CUSTOM_ID: agent-" akey)
               (displayln ":ORG_NODE_KIND: agent")
               (displayln ":AGENT_KEY: " akey)
               (displayln ":AGENT_ID: " (.get adef identity))
               (displayln ":ROLE_KEY: " (.get adef role))
               (displayln ":PARENT_AGENT: " (if (.get adef parent) (.get adef parent) "root"))
               (displayln ":DOMAINS: " (symbols->csv (.get adef domains)))
               (displayln ":END:")))
           agents)
          (newline)
          (displayln "* GitOps Artifact Topology")
          (displayln ":PROPERTIES:")
          (displayln ":CUSTOM_ID: artifact-topology")
          (displayln ":ORG_NODE_KIND: topology-root")
          (displayln ":END:")
          (for-each
           (lambda (dkv)
             (let* ((dkey (car dkv))
                    (ddef (cdr dkv))
                    (dom-cols (filter (lambda (ckv) (eq? (.get (cdr ckv) domain) dkey))
                                      collections)))
               (displayln "** Domain " dkey)
               (displayln ":PROPERTIES:")
               (displayln ":CUSTOM_ID: domain-" dkey)
               (displayln ":ORG_NODE_KIND: domain")
               (displayln ":DOMAIN_KEY: " dkey)
               (displayln ":DOMAIN_PATH: " (.get ddef path))
               (displayln ":WORKTREE_SCOPE: " (.get ddef worktree-scope))
               (displayln ":END:")
               (for-each
                (lambda (ckv)
                  (let* ((ckey (car ckv))
                         (cdef (cdr ckv))
                         (col-rows (filter (lambda (r)
                                             (eq? (.get (.get r payload) collection) ckey))
                                           normalized)))
                    (displayln "*** Collection " ckey)
                    (displayln ":PROPERTIES:")
                    (displayln ":CUSTOM_ID: collection-" ckey)
                    (displayln ":ORG_NODE_KIND: collection")
                    (displayln ":COLLECTION_KEY: " ckey)
                    (displayln ":DOMAIN_KEY: " dkey)
                    (displayln ":COLLECTION_DIR: " (.get cdef directory))
                    (displayln ":INDEX_FILE: " (.get cdef index-file))
                    (displayln ":COLLECTION_CONTRACT_ID: " (.get cdef contract-id))
                    (displayln ":ALLOWED_KINDS: " (symbols->csv (.get cdef allowed-kinds)))
                    (displayln ":END:")
                    (for-each
                     (lambda (r)
                       (emit-artifact-headline! "****" (.get r id) (.get r payload)))
                     col-rows)))
                dom-cols)))
           domains))))))

(def (root-drawer-properties graph)
  (let* ((records (.get graph records))
         (id-of (.get graph id-of))
         (parent-of (.get graph parent-of))
         (kind-of (.get graph kind-of))
         (field-of (.get graph field-of))
         (doc (find (lambda (e) (not (parent-of e))) records))
         (doc-id (and doc (id-of doc)))
         (drawer (and doc-id
                      (find (lambda (e)
                              (and (equal? (kind-of e) "property-drawer")
                                   (equal? (parent-of e) doc-id)))
                            records)))
         (drawer-id (and drawer (id-of drawer))))
    (if (not drawer-id)
      '()
      (filter-map
       (lambda (e)
         (and (equal? (kind-of e) "node-property")
              (equal? (parent-of e) drawer-id)
              (let ((k (field-of e "key")) (v (field-of e "value")))
                (and (string? k) (string? v)
                     (cons (string-upcase (string-trim k)) (string-trim v))))))
       records))))

(def (inspect-context-org catalog org-text)
  (admit-organization! (.get catalog organization))
  (let* ((projected (marlin-context-org-source-graph org-text))
         (graph (.get projected graph))
         (records (.get graph records))
         (id-of (.get graph id-of))
         (parent-of (.get graph parent-of))
         (kind-of (.get graph kind-of))
         (field-of (.get graph field-of))
         (root-props (root-drawer-properties graph))
         (root-ref (lambda (k) (let (p (assoc k root-props)) (and p (cdr p)))))
         (headlines (filter (lambda (e) (equal? (kind-of e) "headline")) records))
         (by-id (make-hash-table)))
    (for-each (lambda (h) (hash-put! by-id (id-of h) h)) headlines)
    (unless (and (equal? (root-ref "ID") (string-append (.get catalog identity) "-root"))
                 (equal? (root-ref "CONTRACT_ID") (.get catalog contract-id))
                 (equal? (root-ref "CONTRACT_REVISION") (.get catalog contract-revision))
                 (equal? (root-ref "PROJECT_ID") (.get catalog project))
                 (equal? (root-ref "ORGANIZATION_ID") (.get (.get catalog organization) identity)))
      (error "GitOps context root properties do not match declared Artifact catalog contract"))
    (let ((role-nodes (filter (lambda (h) (equal? (field-of h "property:ORG_NODE_KIND") "role")) headlines))
          (agent-nodes (filter (lambda (h) (equal? (field-of h "property:ORG_NODE_KIND") "agent")) headlines))
          (domain-nodes (filter (lambda (h) (equal? (field-of h "property:ORG_NODE_KIND") "domain")) headlines))
          (col-nodes (filter (lambda (h) (equal? (field-of h "property:ORG_NODE_KIND") "collection")) headlines))
          (art-nodes (filter (lambda (h)
                               (or (equal? (field-of h "property:ORG_NODE_KIND") "artifact")
                                   (field-of h "property:ARTIFACT")
                                   (field-of h "property:ID")))
                             headlines))
          (org (.get catalog organization)))
      (when (<= (+ 1 (length art-nodes)) 32)
        (marlin-context-org-contract-source
         (.o identity: "context.org" generation: 1 source: org-text)))
      (unless (and (= (length role-nodes) (length (.alist/sort (.get org roles))))
                   (= (length agent-nodes) (length (.alist/sort (.get org agents))))
                   (= (length domain-nodes) (length (.alist/sort (.get catalog domains))))
                   (= (length col-nodes) (length (.alist/sort (.get catalog collections)))))
        (error "GitOps Artifact declaration count differs from declared Catalog topology"))
      (for-each
       (lambda (h)
         (let* ((rkey-str (field-of h "property:ROLE_KEY"))
                (rkey (and rkey-str (string->symbol rkey-str)))
                (_ (unless (and rkey (.slot? (.get org roles) rkey))
                     (error "Unknown Role in GitOps Artifact projection" rkey-str)))
                (rdef (.ref (.get org roles) rkey)))
           (unless (and (equal? (field-of h "property:ROLE_ID") (.get rdef identity))
                        (equal? (csv->symbols (field-of h "property:CAPABILITIES"))
                                (.get rdef capabilities))
                        (equal? (field-of h "property:REVIEW_ELIGIBLE")
                                (if (.get rdef review-eligible?) "true" "false")))
             (error "Artifact Role definition drifted from declared Organization" rkey))))
       role-nodes)
      (for-each
       (lambda (h)
         (let* ((akey-str (field-of h "property:AGENT_KEY"))
                (akey (and akey-str (string->symbol akey-str)))
                (_ (unless (and akey (.slot? (.get org agents) akey))
                     (error "Unknown Agent in GitOps Artifact projection" akey-str)))
                (adef (.ref (.get org agents) akey))
                (expected-parent (if (.get adef parent) (symbol->string (.get adef parent)) "root")))
           (unless (and (equal? (field-of h "property:AGENT_ID") (.get adef identity))
                        (equal? (field-of h "property:ROLE_KEY") (symbol->string (.get adef role)))
                        (equal? (field-of h "property:PARENT_AGENT") expected-parent)
                        (equal? (csv->symbols (field-of h "property:DOMAINS"))
                                (.get adef domains)))
             (error "Artifact Agent definition drifted from declared Organization" akey))))
       agent-nodes)
      (for-each
       (lambda (h)
         (let* ((ckey-str (field-of h "property:COLLECTION_KEY"))
                (ckey (and ckey-str (string->symbol ckey-str)))
                (_ (unless (and ckey (.slot? (.get catalog collections) ckey))
                     (error "Unknown Collection in GitOps Artifact projection" ckey-str)))
                (cdef (.ref (.get catalog collections) ckey))
                (parent-h (hash-get by-id (parent-of h))))
           (unless (and parent-h
                        (equal? (field-of parent-h "property:ORG_NODE_KIND") "domain")
                        (equal? (field-of parent-h "property:DOMAIN_KEY")
                                (symbol->string (.get cdef domain)))
                        (equal? (field-of h "property:COLLECTION_DIR") (.get cdef directory))
                        (equal? (field-of h "property:INDEX_FILE") (.get cdef index-file))
                        (equal? (field-of h "property:COLLECTION_CONTRACT_ID") (.get cdef contract-id)))
             (error "Artifact Collection placement drifted from Catalog topology" ckey))))
       col-nodes)
      (let* ((parsed-artifacts
              (map
               (lambda (h)
                 (let* ((id (field-of h "property:ID"))
                        (kind-str (field-of h "property:ARTIFACT_KIND"))
                        (col-str (field-of h "property:COLLECTION"))
                        (dom-str (field-of h "property:DOMAIN"))
                        (dir-str (field-of h "property:COLLECTION_DIR"))
                        (wt (field-of h "property:WORKTREE_ID"))
                        (commit (field-of h "property:GIT_COMMIT"))
                        (prod-str (field-of h "property:PRODUCER_KEY"))
                        (prod-agent (field-of h "property:PRODUCER_AGENT"))
                        (owner-role-str (field-of h "property:OWNER_ROLE"))
                        (rev-str (field-of h "property:REVIEWER_KEY"))
                        (rev-agent (field-of h "property:REVIEWER_AGENT"))
                        (cid (field-of h "property:CONTRACT_ID"))
                        (digest (field-of h "property:ARTIFACT"))
                        (parent-h (hash-get by-id (parent-of h))))
                   (unless (and (nonempty-text? id) kind-str col-str dom-str
                                parent-h
                                (equal? (field-of parent-h "property:ORG_NODE_KIND") "collection")
                                (equal? (field-of parent-h "property:COLLECTION_KEY") col-str))
                     (error "Artifact headline is not placed inside its declared Collection" id col-str))
                   (let* ((artifact-kind (string->symbol kind-str))
                          (collection (string->symbol col-str))
                          (worktree wt)
                          (producer (and prod-str (string->symbol prod-str)))
                          (reviewer (and rev-str (string->symbol rev-str)))
                          (admitted
                           (admit-artifact-record
                            catalog
                            (.o artifact-kind collection commit worktree digest
                                producer reviewer))))
                     (unless (and (equal? dom-str (symbol->string (.get admitted domain)))
                                  (equal? dir-str (.get admitted directory))
                                  (equal? prod-agent (.get admitted producer-agent))
                                  (equal? owner-role-str (symbol->string (.get admitted owner-role)))
                                  (equal? cid (.get admitted contract-id))
                                  (equal? rev-agent (.get admitted reviewer-agent)))
                       (error "Artifact headline metadata contradicts Organization/Catalog admission" id))
                     (let ((id (string-copy id)) (payload admitted))
                       (.o id payload)))))
               art-nodes))
             (ids (map (lambda (r) (.get r id)) parsed-artifacts)))
        (unless (= (length ids) (length (delete-duplicates/hash ids)))
          (error "Duplicate Artifact IDs in GitOps Artifact projection"))
        (let ((valid? #t)
              (project (string-copy (.get catalog project)))
              (organization-id (string-copy (.get org identity)))
              (role-count (length role-nodes))
              (agent-count (length agent-nodes))
              (collection-count (length col-nodes))
              (artifacts parsed-artifacts)
              (digests (list->vector (map (lambda (r) (.get (.get r payload) digest)) parsed-artifacts))))
          (.o valid? project organization-id
              role-count agent-count collection-count
              artifacts digests))))))

(def (render-topology-file catalog collections)
  (call-with-output-string
    (lambda (port)
      (parameterize ((current-output-port port))
        (displayln ":PROPERTIES:")
        (displayln ":ID: " (.get catalog identity) "-topology")
        (displayln ":CONTRACT_ID: context.gitops.topology.v1")
        (displayln ":CONTRACT_REVISION: 1")
        (displayln ":PROJECT_ID: " (.get catalog project))
        (displayln ":END:")
        (displayln "#+title: " (.get catalog project) " GitOps Artifact Topology")
        (displayln "#+language: en")
        (newline)
        (displayln "* Contract")
        (displayln ":PROPERTIES:")
        (displayln ":CONTRACT_ID: context.gitops.topology.v1")
        (displayln ":CONTRACT_SCOPE: document")
        (displayln ":END:")
        (newline)
        (displayln "#+begin_src scheme :org-contract")
        (displayln "(assert-org-element \"topology.file-contract\" error")
        (displayln "  (bindings")
        (displayln "   (bind file-properties (org-elements property-drawer (child-of scope))))")
        (displayln "  (org-elements node-property (child-of file-properties)")
        (displayln "                (property key \"CONTRACT_ID\")")
        (displayln "                (property value \"context.gitops.topology.v1\"))")
        (displayln "  (expect exactly 1))")
        (newline)
        (displayln "(assert-org-element \"topology.entry-sources\" error")
        (displayln "  (bindings)")
        (displayln "  (org-elements node-property (descendant-of scope)")
        (displayln "                (property key \"ENTRY_SOURCE\"))")
        (displayln "  (expect at-least 1))")
        (displayln "#+end_src")
        (for-each
         (lambda (ckv)
           (let* ((ckey (car ckv))
                  (cdef (cdr ckv))
                  (entry-rel (string-append (.get cdef directory) "/" (.get cdef index-file))))
             (newline)
             (displayln "* Collection " ckey)
             (displayln ":PROPERTIES:")
             (displayln ":ID: topo-" ckey)
             (displayln ":ARCH_COMPONENT: " (.get catalog project) "/" ckey)
             (displayln ":ENTRY_SOURCE: " entry-rel)
             (displayln ":END:")
             (displayln "Declarative GitOps Artifact collection entry.")))
         collections)))))

(def (render-collection-file catalog ckey cdef col-rows)
  (call-with-output-string
    (lambda (port)
      (parameterize ((current-output-port port))
        (displayln ":PROPERTIES:")
        (displayln ":ID: collection-" ckey "-root")
        (displayln ":CONTRACT_ID: " (.get cdef contract-id))
        (displayln ":CONTRACT_REVISION: 1")
        (displayln ":PROJECT_ID: " (.get catalog project))
        (displayln ":COLLECTION_KEY: " ckey)
        (displayln ":END:")
        (displayln "#+title: Collection " ckey)
        (displayln "#+language: en")
        (newline)
        (displayln "* Contract")
        (displayln ":PROPERTIES:")
        (displayln ":CONTRACT_ID: " (.get cdef contract-id))
        (displayln ":CONTRACT_SCOPE: document")
        (displayln ":END:")
        (newline)
        (displayln "#+begin_src scheme :org-contract")
        (displayln "(assert-org-element \"collection.file-contract\" error")
        (displayln "  (bindings")
        (displayln "   (bind file-properties (org-elements property-drawer (child-of scope))))")
        (displayln "  (org-elements node-property (child-of file-properties)")
        (displayln "                (property key \"CONTRACT_ID\")")
        (displayln "                (property value \"" (.get cdef contract-id) "\"))")
        (displayln "  (expect exactly 1))")
        (displayln "#+end_src")
        (for-each
         (lambda (r)
           (newline)
           (emit-artifact-headline!
            "*"
            (string-append (symbol->string ckey) "-" (.get r id))
            (.get r payload)))
         col-rows)))))

(def (plan-artifact-directory catalog rows)
  (let* ((normalized (map (cut normalize-committed-row catalog <>) rows))
         (index-org (project-context-org catalog normalized))
         (collections (ordered-entries (.get catalog collections)
                                       '(topology evidence work patches receipts)))
         (topo-rel "shared/topology/topology.org")
         (topo-org (render-topology-file catalog collections))
         (col-files
          (filter-map
           (lambda (ckv)
             (let* ((ckey (car ckv))
                    (cdef (cdr ckv))
                    (rel (string-append (.get cdef directory) "/" (.get cdef index-file)))
                    (col-rows (filter (lambda (r)
                                        (eq? (.get (.get r payload) collection) ckey))
                                      normalized)))
               ;; `shared/topology/topology.org` is already emitted as the canonical topology entry
               (and (not (equal? rel topo-rel))
                    (let ((path rel)
                          (content (render-collection-file catalog ckey cdef col-rows)))
                      (.o path content)))))
           collections))
         (files (cons* (.o path: "context.org" content: index-org)
                       (.o path: topo-rel content: topo-org)
                       col-files)))
    (.o index-org files)))

(def (validate-artifact-directory root-directory)
  (let* ((proto (.get LabOrgDirectory profile-prototype))
         (profile (.o (:: @ proto) directory: (string-copy root-directory))))
    ((.get LabOrgDirectory validate) profile)))

(def (materialize-artifact-directory! catalog rows root-directory)
  (let ((plan (plan-artifact-directory catalog rows)))
    (create-directory* root-directory)
    (create-directory* (path-expand "artifacts" root-directory))
    (create-directory* (path-expand "data" root-directory))
    (for-each
     (lambda (entry)
       (let (full (path-expand (.get entry path) root-directory))
         (create-directory* (path-directory full))
         (call-with-output-file full
           (lambda (port) (display (.get entry content) port)))))
     (.get plan files))
    (let (validation (validate-artifact-directory root-directory))
      (unless (and (.get validation complete?) (.get validation passed?))
        (error "Materialized GitOps Artifact directory failed Org Contract validation" validation))
      (.o plan validation))))

(def (record! journal record)
  (def id ((.get LabDurableJournal hash) ((.get LabDurableJournal pack) record)))
  (unless ((.get LabDurableJournal get) journal id)
    ((.get LabDurableJournal receive!) journal id record)
    ((.get LabDurableJournal begin!) journal id)
    ((.get LabDurableJournal put!) journal id record)
    ((.get LabDurableJournal commit!) journal)))

(def (recover-context journal (catalog DefaultArtifactCatalog))
  (def committed
    (filter-map
     (lambda (row)
       (and (equal? (.get row status) "applied")
            (eq? (.get row payload kind) 'marlin.artifact)
            (normalize-committed-row catalog row)))
     ((.get LabDurableJournal rows) journal)))
  (def source (project-context-org catalog committed))
  (def inspected (inspect-context-org catalog source))
  (def parsed-by-id (make-hash-table test: equal?))
  (for-each
   (lambda (entry) (hash-put! parsed-by-id (.get entry id) (.get entry payload)))
   (.get inspected artifacts))
  (unless (= (hash-length parsed-by-id) (length committed))
    (error "Missing Org artifact records"))
  (def ordered-digests
    (map
     (lambda (row)
       (let* ((id (.get row id))
              (expected (.get row payload))
              (parsed (hash-get parsed-by-id id))
              (raw ((.get LabDurableJournal get) journal id)))
         (unless (and raw parsed
                      (equal? (.get parsed digest) (.get expected digest))
                      (equal? (.get parsed commit) (.get expected commit))
                      (eq? (.get parsed artifact-kind) (.get expected artifact-kind))
                      (eq? (.get parsed collection) (.get expected collection))
                      (eq? (.get parsed producer) (.get expected producer)))
           (error "Org reference differs from the committed artifact" id))
         (.get expected digest)))
     committed))
  (vector source (list->vector ordered-digests)))

(def artifacts-admit-record admit-artifact-record)
(def artifacts-project-context-org project-context-org)
(def artifacts-inspect-context-org inspect-context-org)
(def artifacts-plan-artifact-directory plan-artifact-directory)
(def artifacts-materialize-artifact-directory! materialize-artifact-directory!)
(def artifacts-validate-artifact-directory validate-artifact-directory)

(def (artifacts-exchange request)
  (def (with-journal path action)
    (def journal ((.get LabDurableJournal open) path))
    (dynamic-wind void
      (lambda () ((.get LabDurableJournal verify!) journal) (action journal))
      (lambda () ((.get LabDurableJournal close!) journal))))
  (match request
    (#('restore path)
     (with-journal path (cut recover-context <> DefaultArtifactCatalog)))
    (#('restore path catalog)
     (with-journal path (cut recover-context <> catalog)))
    (#('record path kind commit worktree digest)
     (def record (admit-artifact-record
                  DefaultArtifactCatalog
                  (.o kind commit worktree digest)))
     (with-journal path
       (lambda (journal)
         (record! journal record)
         (recover-context journal DefaultArtifactCatalog))))
    (#('record-governed path spec)
     (def record (admit-artifact-record DefaultArtifactCatalog spec))
     (with-journal path
       (lambda (journal)
         (record! journal record)
         (recover-context journal DefaultArtifactCatalog))))
    (#('record-governed path spec catalog)
     (def record (admit-artifact-record catalog spec))
     (with-journal path
       (lambda (journal)
         (record! journal record)
         (recover-context journal catalog))))
    (else (error "Invalid artifact request"))))
