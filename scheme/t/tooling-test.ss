(import (only-in :clan/poo/object .get)
        (only-in :std/string/misc string-contains)
        (only-in :marlin-agent-core/init marlin-agent-core.init.exports))

(def tooling (.get marlin-agent-core.init.exports Marlin tooling))
(def declarations ((.get tooling project)))
(def bash-decl (vector-ref declarations 0))
(def bash-desc (vector-ref bash-decl 1))
(def search-decl (vector-ref declarations 1))
(def search-desc (vector-ref search-decl 1))
(def structural-decl (vector-ref declarations 2))
(def structural-desc (vector-ref structural-decl 1))
(def constraint-decl (vector-ref declarations 3))
(def constraint-desc (vector-ref constraint-decl 1))
(unless (and (eq? (.get tooling identity) 'marlin/tooling)
             (= (vector-length declarations) 4)
             (eq? (vector-ref bash-decl 0) 'bash)
             (string? bash-desc)
             (string-contains bash-desc "workspace_search")
             (string-contains bash-desc "structural_query")
             (string-contains bash-desc "constraint_solve")
             (eq? (vector-ref bash-decl 2) 'shell)
             (eq? (vector-ref bash-decl 3) 'ask)
             (eq? (vector-ref bash-decl 4) 'command)
             (= (vector-ref bash-decl 5) 30)
             (= (vector-ref bash-decl 6) 65536)
             ;; L0: workspace_search
             (eq? (vector-ref search-decl 0) 'workspace_search)
             (string? search-desc)
             (<= (string-length search-desc) 2048)
             (string-contains search-desc "(brute-search ")
             (string-contains search-desc "(file-outline ")
             (string-contains search-desc "(read-file ")
             (string-contains search-desc "exclude-tests?: #t")
             (string-contains search-desc "symbol:")
             (not (string-contains search-desc "@sym:"))
             (eq? (vector-ref search-decl 2) 'search)
             (eq? (vector-ref search-decl 3) 'ask)
             (eq? (vector-ref search-decl 4) 'query)
             (= (vector-ref search-decl 5) 10)
             (= (vector-ref search-decl 6) 65536)
             ;; L1: structural_query
             (eq? (vector-ref structural-decl 0) 'structural_query)
             (string? structural-desc)
             (<= (string-length structural-desc) 2048)
             (string-contains structural-desc "(find-impact ")
             (string-contains structural-desc "(find-collisions ")
             (string-contains structural-desc "exclude-tests?: #t")
             (string-contains structural-desc "name-contains:")
             (string-contains structural-desc "(find-callers ")
             (string-contains structural-desc "(ascent-fragment ")
             (eq? (vector-ref structural-decl 2) 'search)
             (eq? (vector-ref structural-decl 3) 'ask)
             (eq? (vector-ref structural-decl 4) 'query)
             (= (vector-ref structural-decl 5) 15)
             (= (vector-ref structural-decl 6) 65536)
             ;; L2: constraint_solve
             (eq? (vector-ref constraint-decl 0) 'constraint_solve)
             (string? constraint-desc)
             (<= (string-length constraint-desc) 2048)
             (string-contains constraint-desc "(solve-placement ")
             (string-contains constraint-desc "(solve-resolve ")
             (string-contains constraint-desc "(search-choice-program ")
             (string-contains constraint-desc "hot-path-module")
             (string-contains constraint-desc "provenance?: #t")
             (eq? (vector-ref constraint-decl 2) 'search)
             (eq? (vector-ref constraint-decl 3) 'ask)
             (eq? (vector-ref constraint-decl 4) 'query)
             (= (vector-ref constraint-decl 5) 15)
             (= (vector-ref constraint-decl 6) 65536))
  (error "selected tooling declaration changed" declarations))
(displayln "TOOLING-OK")
