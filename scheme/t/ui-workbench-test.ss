;;; Test the selected module, including extension admission and focus.
(import (only-in :clan/poo/object .cc .get .o .put!)
        (only-in :marlin-agent-core/init marlin-agent-core.init.exports)
        (only-in :marlin-agent-core/ui/projection marlin-ui-native-facts marlin-ui-apply-native
                 marlin-ui-apply-event marlin-ui-project-intent)
        (only-in :marlin-agent-core/ui/workbench marlin-ui-workbench)
        (only-in :yuanxu/poo-clos/objects poo-clos-compose-method-bundle)
        (only-in :yuanxu/poo-clos/generic-syntax .defgeneric .defmethod)
        (only-in :yuanxu/poo-clos/method-bundle-syntax .defmethod-bundle))

(export ui-workbench-verified)

(def ui (.get marlin-agent-core.init.exports Marlin ui))
(def c-abi (.get marlin-agent-core.init.exports Marlin c-abi))
(unless (and (eq? (.get c-abi identity) 'marlin/c-abi)
             (eq? (.get c-abi ui) ui)
             (eq? (.get c-abi context) (.get marlin-agent-core.init.exports Marlin context))
             (eq? (.get c-abi deck-runtime) (.get marlin-agent-core.init.exports Marlin deck-runtime)))
  (error "native ABI Module was not selected"))
(def workbench (.get ui workbench))
(def (facts values)
  (.o model: "anthropic/example" session: "saved" contributions: values extensions: '()))
(def output (workbench (facts (list (.o identity: 'example/status label: "Ready")))))
(unless (and (eq? (.get output identity) 'workbench)
             (equal? (map (lambda (node) (.get node identity)) (.get output regions))
                     '(transcript composer commands status))
             (eq? (.get (car (.get (list-ref (.get output regions) 3) children)) identity)
                  'example/status))
  (error "UI workbench publication failed"))
(def (rejected? thunk) (with-catch (lambda (_) #t) (lambda () (thunk) #f)))
(let* ((entries (map (lambda (id) (.o identity: id label: "ok"))
                     '(a b c d e f g h)))
       (accepted (workbench (facts entries))))
  (unless (and (= (length (.get (list-ref (.get accepted regions) 3) children)) 8)
               (rejected? (lambda () (workbench
                                      (facts (append entries (list (.o identity: 'i label: "ok"))))))))
    (error "UI contribution limit boundary failed")))
(let* ((entry (.o identity: 'cycle label: "cycle"))
       (cycle (cons entry '())))
  (set-cdr! cycle cycle)
  (unless (and (rejected? (lambda () (marlin-ui-workbench (facts cycle))))
               (rejected? (lambda () (workbench (facts cycle))))
               (rejected? (lambda () (marlin-ui-workbench (facts (cons entry 'bad)))))
               (rejected? (lambda () (marlin-ui-workbench
                                      (.o model: "m" session: "s" contributions: '()
                                          extensions: cycle)))))
    (error "unbounded or improper UI inputs were accepted")))
(unless (and (rejected? (lambda () (workbench (facts (list (.o identity: 'composer label: "bad"))))))
             (rejected? (lambda () (workbench (facts (list (.o identity: 'x label: "a")
                                                           (.o identity: 'x label: "b"))))))
             (rejected? (lambda () (workbench (facts (make-list 9 (.o identity: 'x label: "a")))))))
  (error "invalid UI contribution or focus was accepted"))

;;; An extension specializes both the component and event independently. Its
;;; registration affects this generic instance, not the core module's generic.
(def selected-composer (.get ui components composer))
(def selected-event (.get ui events base))
(def selected-next-focus (.get ui events next-focus))
(def focus-event (.o (:: @ selected-next-focus) order: '(transcript commands composer)))
(def SpecialComposer. (.o (:: @ selected-composer)))
(def SpecialEvent. (.o (:: @ selected-event)))
(def generic ((.get ui make-dispatch) #()))
(def independent-generic ((.get ui make-dispatch) #()))
(unless (and (eq? (.get ((.get ui dispatch) generic (list-ref (.get output regions) 1)
                          focus-event) identity) 'transcript)
             (eq? (.get ((.get ui dispatch) generic (list-ref (.get output regions) 2)
                          focus-event) identity) 'composer))
  (error "UI focus dispatch failed"))
(let* ((previous (.get ui previous-focus-event))
       (event (previous output))
       (dispatch (.get ui dispatch)))
  (unless (and (eq? (.get (dispatch generic (list-ref (.get output regions) 1) event) identity) 'transcript)
               (eq? (.get (dispatch generic (list-ref (.get output regions) 0) event) identity) 'commands))
    (error "reverse UI focus dispatch failed")))
(let* ((dispatch (.get ui dispatch))
       (custom (.o (:: @ selected-composer) identity: 'extension/editor))
       (event (.o (:: @ selected-next-focus) order: '(composer extension/editor transcript))))
  (unless (and (eq? (.get (dispatch generic (list-ref (.get output regions) 1) event) identity)
                    'extension/editor)
               (eq? (.get (dispatch generic custom event) identity) 'transcript)
               (rejected? (lambda () (dispatch generic custom
                 (.o (:: @ selected-next-focus) order: '(composer composer)))))
               (rejected? (lambda () (dispatch generic custom
                 (.o (:: @ selected-next-focus) order: '(composer transcript))))))
    (error "extensible UI focus order failed")))
(let* ((extension-type (.get ui components extension))
       (text-item (.o (:: @ (.get ui components text)) kind: 'text text: "Preview"))
       (field-item (.o (:: @ (.get ui components field))
                       kind: 'field label: "Mode" value: "Review"))
       (extension (.o (:: @ extension-type) identity: 'extension/editor kind: 'extension
                      label: "Editor" focusable: #t content: (list text-item field-item)))
       (passive (.o (:: @ extension-type) identity: 'extension/info kind: 'extension
                    label: "Info" focusable: #f content: '()))
       (request (.o model: "model" session: "session" contributions: '()
                    extensions: (list extension passive)))
       (view (workbench request))
       (regions (.get view regions))
       (event ((.get ui focus-event) view))
       (projected ((.get ui project-workbench) view))
       (native-result (marlin-ui-apply-native ui (vector "model" "session" #() (vector extension)))))
  (.defgeneric extension-event (component event) (protocol (.get ui event-protocol)))
  (.defmethod-bundle ExtensionMethods (.get ui event-protocol)
    (.defmethod (extension-event (component (prototype extension))
                                (event (prototype SpecialEvent.)))
      (.o kind: 'extension-handled)))
  (poo-clos-compose-method-bundle generic ExtensionMethods)
  (unless (and (not (eq? (list-ref regions 3) extension))
               (equal? (.get view focus-order) '(transcript composer commands extension/editor))
               (eq? (.get ((.get ui dispatch) generic (list-ref regions 2) event) identity)
                    'extension/editor)
               (equal? (vector-ref (vector-ref (vector-ref projected 2) 3) 2)
                       '#("Editor" #t #(#(text "Preview") #(field "Mode" "Review"))))
               (equal? (vector-ref (vector-ref (vector-ref native-result 2) 3) 2)
                       '#("Editor" #t #(#(text "Preview") #(field "Mode" "Review"))))
               (eq? (.get ((.get ui dispatch) generic (list-ref regions 3)
                           (.o (:: @ SpecialEvent.))) kind) 'extension-handled)
               (rejected? (lambda () (marlin-ui-native-facts
                                      (vector "m" "s" #() (make-vector 17 extension)))))
               (rejected? (lambda () (workbench (.o model: "m" session: "s" contributions: '()
                                                    extensions: (list extension extension)))))
               (rejected? (lambda () (workbench (.o model: "m" session: "s"
                                  contributions: (list (.o identity: 'extension/editor label: "Conflict"))
                                  extensions: (list extension)))))
               (rejected? (lambda () (workbench (.o model: "m" session: "s" contributions: '()
                                                    extensions: (list (.o identity: 'fake kind: 'extension
                                                                            label: "Fake" focusable: #t
                                                                            content: '()))))))
               (rejected? (lambda () (workbench
                 (.o model: "m" session: "s" contributions: '()
                     extensions: (list (.o (:: @ extension-type) identity: 'bad kind: 'extension
                                           label: "Bad" focusable: #t
                                           content: (list (.o kind: 'text text: "forged")))))))))
    (error "UI extension composition failed"))
  (.put! extension 'identity 'extension/changed)
  (.put! extension 'focusable #f)
  (.put! text-item 'text "changed")
  (unless (and (eq? (.get (list-ref regions 3) identity) 'extension/editor)
               (.get (list-ref regions 3) focusable)
               (equal? (.get (car (.get (list-ref regions 3) content)) text) "Preview")
               (rejected? (lambda () (.put! (list-ref regions 3) 'identity 'forged))))
    (error "UI extension snapshot changed after composition")))
(let* ((dispatch (.get ui dispatch))
       (regions (.get output regions))
       (submit ((.get ui dispatch) generic (list-ref regions 1)
                  (.o (:: @ (.get ui events submit)))))
       (dismiss (dispatch generic (list-ref regions 2) (.o (:: @ (.get ui events dismiss)))))
       (scroll (dispatch generic (car regions) (.o (:: @ (.get ui events scroll)) direction: 'up))))
  (unless (and (eq? (.get submit kind) 'submit-draft)
               (eq? (.get dismiss kind) 'focus) (eq? (.get dismiss identity) 'composer)
               (eq? (.get scroll kind) 'scroll) (eq? (.get scroll direction) 'up)
               (equal? (marlin-ui-apply-event ui generic output 'composer
                          (.o (:: @ (.get ui events submit)))) #(submit-draft))
               (equal? (marlin-ui-apply-event ui generic output 'composer
                          ((.get ui focus-event) output)) #(focus commands))
               (equal? (marlin-ui-apply-event ui generic output 'composer
                          ((.get ui previous-focus-event) output)) #(focus transcript))
               (rejected? (lambda () (marlin-ui-apply-event ui generic output 'status
                                      (.o (:: @ (.get ui events submit))))))
               (rejected? (lambda () (marlin-ui-apply-event ui generic output 'composer focus-event)))
               (rejected? (lambda () (marlin-ui-apply-event ui generic output 'composer
                 (.o (:: @ (.get ui events previous-focus)) order: '(composer transcript)))))
               (equal? (marlin-ui-project-intent dismiss) #(focus composer))
               (equal? (marlin-ui-project-intent scroll) #(scroll up))
               (rejected? (lambda () (marlin-ui-project-intent (.o kind: 'unknown))))
               (rejected? (lambda () (marlin-ui-project-intent (.o kind: 'focus identity: 7))))
               (rejected? (lambda () (dispatch generic (car regions)
                                       (.o (:: @ (.get ui events scroll)) direction: 'invalid)))))
    (error "UI event intent dispatch failed")))
(def ForgedFocusEvent. (.o (:: @ selected-event)))
(.defgeneric forged-focus (component event) (protocol (.get ui event-protocol)))
(.defmethod-bundle ForgedFocusMethods (.get ui event-protocol)
  (.defmethod (forged-focus (component (prototype selected-composer))
                            (event (prototype ForgedFocusEvent.)))
    (.o kind: 'focus identity: 'not-present)))
(poo-clos-compose-method-bundle generic ForgedFocusMethods)
(unless (rejected? (lambda () (marlin-ui-apply-event ui generic output 'composer
                               (.o (:: @ ForgedFocusEvent.)))))
  (error "UI event admitted a focus outside the workbench"))
(.defgeneric example-event (component event) (protocol (.get ui event-protocol)))
(.defmethod-bundle ExampleEventMethods (.get ui event-protocol)
  (.defmethod (example-event (component (prototype SpecialComposer.))
                             (event (prototype SpecialEvent.)))
    (.o identity: 'example/handled)))
(poo-clos-compose-method-bundle generic ExampleEventMethods)
(unless (and
  (eq? (.get ((.get ui dispatch) generic (.o (:: @ SpecialComposer.))
                              (.o (:: @ SpecialEvent.))) identity) 'example/handled)
  (eq? (.get ((.get ui dispatch) generic (.o (:: @ SpecialComposer.) identity: 'composer)
                              focus-event) identity) 'transcript)
  (eq? (.get ((.get ui dispatch) independent-generic (.o (:: @ SpecialComposer.) identity: 'composer)
                              focus-event) identity) 'transcript)
  (rejected? (lambda () ((.get ui dispatch) independent-generic (.o (:: @ SpecialComposer.))
                                          (.o (:: @ SpecialEvent.)))))
  (rejected? (lambda () ((.get ui dispatch) generic (.o (:: @ selected-composer))
                                          (.o (:: @ SpecialEvent.))))))
  (error "UI two-argument extension dispatch failed"))

(let* ((projected ((.get ui project-workbench)
                    (workbench (marlin-ui-native-facts
                      #("anthropic/example" "saved" #(#(example/status "Ready")) #())))))
       (regions (vector-ref projected 2))
       (status (vector-ref regions 3)))
  (unless (and (equal? (vector-ref projected 0) "anthropic/example")
               (= (vector-length regions) 4)
               (eq? (vector-ref (vector-ref regions 0) 0) 'transcript)
               (equal? (vector-ref (vector-ref (vector-ref status 2) 0) 2) "Ready"))
    (error "UI native projection lost component data")))
(unless (rejected? (lambda () (marlin-ui-native-facts #("bad"))))
  (error "malformed UI native request accepted"))
(let* ((calls 0)
       (custom (.cc ui 'workbench (lambda (facts) (set! calls (+ calls 1)) (workbench facts))))
       (result (marlin-ui-apply-native custom #("model" "session" #() #()))))
  (unless (and (= calls 1) (equal? (vector-ref result 0) "model"))
    (error "native projection ignored the supplied UI scope")))
(displayln "UI-WORKBENCH-OK")
(def ui-workbench-verified #t)
