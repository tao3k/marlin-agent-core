# shellcheck shell=bash

# Enable repository-scoped Marlin data in the project development environment.
export MARLIN_AGENT_CORE_DEV="${MARLIN_AGENT_CORE_DEV-1}"

# Set the budget before Gerbil's compiler initializes. An explicit caller
# value, including zero, remains authoritative.
if [ "${GERBIL_BUILD_CORES+x}" != x ]; then
    _marlin_build_cores=$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)
    case "$_marlin_build_cores" in
        ''|*[!0-9]*|0) _marlin_build_cores=1 ;;
    esac
    export GERBIL_BUILD_CORES="$_marlin_build_cores"
    unset _marlin_build_cores
fi

read -r -a _marlin_nix_profiles <<< "${NIX_PROFILES:-}"
for _marlin_nix_profile in "${_marlin_nix_profiles[@]}"; do
    if [ -d "$_marlin_nix_profile/bin" ]; then
        PATH_add "$_marlin_nix_profile/bin"
    fi
done
unset _marlin_nix_profiles _marlin_nix_profile

if ! has devenv && [ -x "$HOME/.nix-profile/bin/devenv" ]; then
    PATH_add "$HOME/.nix-profile/bin"
fi
if ! has devenv; then
    log_error "devenv is required to load Marlin's development environment"
    return 1
fi

# PRJ base directories.
source_url \
    "https://raw.githubusercontent.com/numtide/prj-spec/9b0ffcd0fddcb261bcd73ad9dad18a096760b4a0/contrib/direnv" \
    "sha256-54YaaGly6Q0E8GhFT9fB/h9tN1PDERo2/4R4X0Pdi/c=" || return 1

source_url \
    "https://raw.githubusercontent.com/cachix/devenv/55d2bb4a3cc710ba82cc8644f4419db3a802e1a4/devenv/direnvrc" \
    "sha256-SedUl6058dnxQASrSeERFCrNESprWThYgZhQ2j4mWss=" || return 1

use devenv
